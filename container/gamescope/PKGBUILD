prepare() {
  local source_dir="${srcdir}/gamescope-${_gamescope_commit}"

  cd "${source_dir}"
  patch -Np1 -i "${srcdir}/pipewire-steam-capture.patch"
  patch -Np1 -i "${srcdir}/headless-output-phys-size.patch"

  rm -rf \
    src/reshade \
    subprojects/libdisplay-info \
    subprojects/libliftoff \
    subprojects/openvr \
    subprojects/vkroots \
    subprojects/wlroots \
    subprojects/glm \
    subprojects/stb \
    thirdparty/SPIRV-Headers

  mv "${srcdir}/reshade-${_reshade_commit}" src/reshade
  mv "${srcdir}/libdisplay-info-${_libdisplay_info_commit}" subprojects/libdisplay-info
  mv "${srcdir}/libliftoff-${_libliftoff_commit}" subprojects/libliftoff
  mv "${srcdir}/openvr-${_openvr_commit}" subprojects/openvr
  mv "${srcdir}/vkroots-${_vkroots_commit}" subprojects/vkroots
  mv "${srcdir}/wlroots-${_wlroots_commit}" subprojects/wlroots
  mv "${srcdir}/glm-${_glm_commit}" subprojects/glm
  mv "${srcdir}/stb-${_stb_commit}" subprojects/stb
  mv "${srcdir}/SPIRV-Headers-${_spirv_headers_commit}" thirdparty/SPIRV-Headers

  cp -a subprojects/packagefiles/glm/. subprojects/glm/
  cp -a subprojects/packagefiles/stb/. subprojects/stb/
}

build() {
  arch-meson "gamescope-${_gamescope_commit}" build \
    -Dforce_fallback_for=glm,stb,libdisplay-info,libliftoff,vkroots \
    -Dpipewire=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="${pkgdir}" meson install -C build --skip-subprojects
  install -Dm 644 "gamescope-${_gamescope_commit}/LICENSE" \
    -t "${pkgdir}/usr/share/licenses/gamescope/"
}

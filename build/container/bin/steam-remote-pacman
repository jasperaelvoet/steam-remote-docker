#!/usr/bin/env bash
set -euo pipefail

PACMAN_REAL=/usr/lib/steam-remote/pacman.real

if [ "$#" -eq 0 ]; then
  exec "${PACMAN_REAL}"
fi

case "$1" in
  -Q* | --query | -V | --version | -h | --help)
    exec "${PACMAN_REAL}" "$@"
    ;;
esac

cat >&2 <<'EOF'
Runtime package changes are disabled in Steam Remote.

Edit build/container/Containerfile and rebuild the immutable image instead.
Installed package queries still work with pacman -Q.
EOF
exit 1

#!/usr/bin/env bash
set -euo pipefail

STEAM_REAL="${STEAM_REMOTE_STEAM_REAL:-/usr/bin/steam}"
STEAM_DEFAULT_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/Steam"
STEAM_BOOTSTRAP_TAR=/usr/share/steam-remote/steam/bootstraplinux_ubuntu12_32.tar.xz

resolve_steam_dir() {
  if [ -n "${STEAM_REMOTE_STEAM_DIR:-}" ]; then
    printf '%s\n' "${STEAM_REMOTE_STEAM_DIR}"
  elif [ -e "${HOME}/.steam/steam" ] || [ -L "${HOME}/.steam/steam" ]; then
    readlink -f "${HOME}/.steam/steam"
  else
    printf '%s\n' "${STEAM_DEFAULT_DIR}"
  fi
}

STEAM_DIR="$(resolve_steam_dir)"
STEAM_DEV_CFG="${STEAM_DIR}/steam_dev.cfg"

ensure_steam_bootstrap() {
  if [ -x "${STEAM_DIR}/steam.sh" ] || [ ! -f "${STEAM_BOOTSTRAP_TAR}" ]; then
    return 0
  fi
  mkdir -p "${STEAM_DIR}"
  tar -xJf "${STEAM_BOOTSTRAP_TAR}" -C "${STEAM_DIR}"
}

safe_link() {
  local target="$1"
  local link="$2"
  if [ -d "${link}" ] && [ ! -L "${link}" ]; then
    return 0
  fi
  ln -sfn "${target}" "${link}"
}

ensure_steam_links() {
  mkdir -p "${HOME}/.steam"
  safe_link "${STEAM_DIR}" "${HOME}/.steam/steam"
  safe_link "${STEAM_DIR}" "${HOME}/.steam/root"
  safe_link "${STEAM_DIR}/ubuntu12_32" "${HOME}/.steam/bin32"
  safe_link "${STEAM_DIR}/ubuntu12_64" "${HOME}/.steam/bin64"
  safe_link "${STEAM_DIR}/linux32" "${HOME}/.steam/sdk32"
  safe_link "${STEAM_DIR}/linux64" "${HOME}/.steam/sdk64"
  safe_link "${HOME}/.steam/bin32" "${HOME}/.steam/bin"
}

clear_stale_ipc() {
  if pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; then
    return 0
  fi
  rm -f "${HOME}/.steam/steam.pid" \
    "${HOME}/.steam/steam.pipe" \
    "${HOME}/.steam/steam.token"
}

configure_shader_threads() {
  local threads
  mkdir -p "$(dirname "${STEAM_DEV_CFG}")" "${STEAM_DIR}/config"
  touch "${STEAM_DIR}/config/SteamAppData.vdf" || true
  if [ ! -f "${STEAM_DEV_CFG}" ] || ! grep -q '^unShaderBackgroundProcessingThreads ' "${STEAM_DEV_CFG}"; then
    threads=$(($(nproc) - 2))
    if [ "${threads}" -gt 16 ]; then
      threads=16
    elif [ "${threads}" -lt 1 ]; then
      threads=1
    fi
    printf 'unShaderBackgroundProcessingThreads %s\n' "${threads}" >>"${STEAM_DEV_CFG}"
  fi
}

clear_offline_mode() {
  local file
  for file in \
    "${STEAM_DIR}/config/loginusers.vdf" \
    "${STEAM_DIR}/config/config.vdf" \
    "${STEAM_DIR}/registry.vdf" \
    "${HOME}/.steam/registry.vdf"; do
    [ -f "${file}" ] || continue
    sed -i -E \
      -e 's/"WantsOfflineMode"[[:space:]]+"1"/"WantsOfflineMode"\t\t"0"/g' \
      -e 's/"SkipOfflineModeWarning"[[:space:]]+"1"/"SkipOfflineModeWarning"\t\t"0"/g' \
      -e 's/"Offline"[[:space:]]+"1"/"Offline"\t\t"0"/g' \
      -e 's/"ForceOfflineMode"[[:space:]]+"1"/"ForceOfflineMode"\t\t"0"/g' \
      "${file}"
  done
}

configure_client_channel() {
  local channel="${STEAM_REMOTE_STEAM_CHANNEL:-inherit}"
  local beta_file="${STEAM_DIR}/package/beta"
  case "${channel,,}" in
    inherit)
      ;;
    beta | publicbeta)
      mkdir -p "$(dirname "${beta_file}")"
      if [ ! -f "${beta_file}" ] || [ "$(<"${beta_file}")" != publicbeta ]; then
        printf 'publicbeta\n' >"${beta_file}"
      fi
      ;;
    stable)
      rm -f "${beta_file}"
      ;;
    *)
      printf 'steam-remote: unsupported STEAM_REMOTE_STEAM_CHANNEL=%q (use inherit, stable, or publicbeta)\n' \
        "${channel}" >&2
      exit 2
      ;;
  esac
}

configure_client_runtime() {
  local enabled="${STEAM_REMOTE_STEAMRT3:-inherit}"
  case "${enabled,,}" in
    1 | true | yes | enabled | steamrt3 | steamrt64)
      # The public beta's steam.sh recognizes this documented internal selector,
      # persists its normal UI marker, and launches the 64-bit SteamRT3 client.
      export STEAM_FORCE_CLIENT=steamrt64
      ;;
    0 | false | no | disabled | legacy | ubuntu12_32)
      export STEAM_FORCE_CLIENT=ubuntu12_32
      ;;
    inherit)
      ;;
    *)
      printf 'steam-remote: unsupported STEAM_REMOTE_STEAMRT3=%q (use inherit, 1, or 0)\n' \
        "${enabled}" >&2
      exit 2
      ;;
  esac
}

export STEAM_RUNTIME=1
export SRT_URLOPEN_PREFER_STEAM=1
export GIO_USE_NETWORK_MONITOR=base
export RES_OPTIONS="timeout:1 attempts:2 rotate single-request-reopen"

ensure_steam_bootstrap
ensure_steam_links
configure_client_channel
configure_client_runtime
clear_stale_ipc
configure_shader_threads
clear_offline_mode

exec "${STEAM_REAL}" "$@"

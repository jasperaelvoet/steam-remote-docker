FROM --platform=linux/amd64 rust:1-slim-bookworm AS rust-builder

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Cache dependencies separately so runtime source edits do not redownload every
# crate on each image build.
COPY build/container/src/steam-remote-rs/Cargo.toml build/container/src/steam-remote-rs/Cargo.lock /src/
RUN mkdir -p /src/src \
    && printf 'fn main() {}\n' > /src/src/main.rs \
    && cargo build --release --locked \
    && rm -rf /src/src /src/target/release/steam-remote /src/target/release/deps/steam_remote-*

COPY build/container/src/steam-remote-rs/src /src/src
RUN cargo build --release --locked \
    && install -D -m 755 target/release/steam-remote /out/steam-remote

FROM --platform=linux/amd64 archlinux:base

USER root

ARG VCS_REF=unknown

LABEL org.opencontainers.image.source="https://github.com/jasperaelvoet/steam-remote-docker" \
      org.opencontainers.image.description="Always-on Steam Remote Play host in an immutable Arch Linux container" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${VCS_REF}"

# Steam is in multilib. Disable pacman's download sandbox because it cannot
# create its restricted namespace under common container build seccomp profiles.
# Arch's mesa and lib32-mesa packages provide the native and 32-bit
# libva-mesa-driver implementations respectively.
RUN printf '\nDisableSandbox\n\n[multilib]\nInclude = /etc/pacman.d/mirrorlist\n' >> /etc/pacman.conf \
    && rm -rf /var/cache/pacman/pkg/* \
    && pacman-key --init \
    && pacman-key --populate archlinux \
    && pacman -Syy --noconfirm archlinux-keyring \
    && pacman -Syu --noconfirm --needed \
      alsa-plugins \
      alsa-utils \
      bash \
      breeze \
      breeze-icons \
      ca-certificates \
      coreutils \
      curl \
      dbus \
      gamescope \
      glibc \
      iproute2 \
      iputils \
      jq \
      kmod \
      kscreen \
      kwin \
      lib32-alsa-lib \
      lib32-alsa-plugins \
      lib32-libpulse \
      lib32-mesa \
      lib32-pipewire \
      lib32-vulkan-icd-loader \
      lib32-vulkan-radeon \
      libcap \
      libdrm \
      libnotify \
      libpulse \
      libva-utils \
      libxcvt \
      mesa \
      mesa-utils \
      noto-fonts \
      noto-fonts-emoji \
      openssl \
      pciutils \
      pipewire \
      pipewire-alsa \
      pipewire-pulse \
      plasma-integration \
      plasma-workspace \
      procps-ng \
      seatd \
      steam \
      tar \
      tini \
      util-linux \
      vulkan-icd-loader \
      vulkan-radeon \
      vulkan-tools \
      wireplumber \
      x11vnc \
      xdg-desktop-portal \
      xdg-desktop-portal-kde \
      xdg-user-dirs \
      xdg-utils \
      xorg-xauth \
      xorg-xrandr \
      xorg-xrdb \
      xorg-xwayland \
    && groupadd -f input \
    && groupadd -f render \
    && groupadd --gid 1000 retro \
    && useradd --create-home --uid 1000 --gid 1000 --shell /bin/bash --groups video,input,render retro \
    && pacman -Scc --noconfirm

RUN sed -i 's/^#\(en_US\.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen \
    && printf 'LANG=en_US.UTF-8\n' > /etc/locale.conf \
    && dbus-uuidgen > /etc/machine-id \
    && install -d -m 755 /var/lib/dbus \
    && ln -sfn /etc/machine-id /var/lib/dbus/machine-id

COPY --chmod=755 build/container/bin/steam-remote-preseed-steam /usr/local/bin/steam-remote-preseed-steam
RUN /usr/local/bin/steam-remote-preseed-steam

COPY --from=rust-builder --chmod=755 /out/steam-remote /usr/local/bin/steam-remote
COPY --chmod=755 build/container/bin/steam-remote-pacman /usr/local/bin/steam-remote-pacman
COPY --chmod=755 build/container/bin/steam-remote-steam /usr/local/bin/steam-remote-steam
COPY --chmod=755 build/container/bin/steam-remote-steamos-update /usr/local/bin/steam-remote-steamos-update

RUN install -d -m 1777 /var/lib/xkb \
    && install -d -m 755 /mnt/user_data /usr/lib/steam-remote \
    && chmod 1777 /tmp /var/tmp \
    && mv /usr/bin/pacman /usr/lib/steam-remote/pacman.real \
    && ln -sf /usr/local/bin/steam-remote-pacman /usr/bin/pacman \
    && ln -sf /usr/local/bin/steam-remote-steam /usr/local/bin/steam \
    && ln -sf /usr/local/bin/steam-remote-steamos-update /usr/bin/steamos-update \
    && (setcap cap_net_raw+ep /usr/bin/ping || chmod 4755 /usr/bin/ping) \
    && sed -i -E 's/^hosts:.*/hosts: files mymachines myhostname dns resolve/' /etc/nsswitch.conf \
    && printf 'precedence ::ffff:0:0/96  100\n' >> /etc/gai.conf \
    && if [ -f /usr/share/applications/steam.desktop ]; then \
      sed -i 's@Exec=/usr/bin/steam@Exec=/usr/local/bin/steam-remote-steam@g' /usr/share/applications/steam.desktop; \
    fi

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    LIBVA_DRIVER_NAME=radeonsi \
    AMD_VULKAN_ICD=RADV

VOLUME ["/mnt/user_data"]

WORKDIR /

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=10s --start-period=5m --retries=3 \
  CMD ["/usr/local/bin/steam-remote", "health"]

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/steam-remote"]
CMD ["run"]

{
  "name": "steam-remote-docker",
  "version": "1.0.0",
  "private": true,
  "description": "Build and validate the Steam Remote Play OCI image",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run typecheck && bun scripts/check.ts && bun scripts/lifecycle.test.ts",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2",
    "vitepress": "^1.6.4"
  }
}

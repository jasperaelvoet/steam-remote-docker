[Unit]
Description=Always-on Steam Remote Play host
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/steam-remote-docker:latest
Pull=never
ContainerName=steam-remote
HostName=steam-remote
Network=host
StopTimeout=30
HealthCmd=/usr/local/bin/steam-remote health
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=5m
HealthRetries=3
PodmanArgs=--ipc=host --privileged --read-only --device-cgroup-rule "c 13:* rmw" --device-cgroup-rule "c 226:* rmw"
AddDevice=/dev/dri
AddDevice=/dev/uinput
AddDevice=/dev/uhid
Volume=/mnt/dev/:/dev/:rw
Volume=/mnt/udev:/run/udev:rw
Volume=/srv/steam-remote:/mnt/user_data:rw
Tmpfs=/run:rw,exec,nosuid,size=1g,mode=755
Tmpfs=/tmp:rw,exec,nosuid,size=8g,mode=1777
Tmpfs=/var/tmp:rw,exec,nosuid,size=2g,mode=1777
Tmpfs=/var/lib/xkb:rw,exec,nosuid,size=64m,mode=1777
Environment=STEAM_REMOTE_WIDTH=3840
Environment=STEAM_REMOTE_HEIGHT=2160
Environment=STEAM_REMOTE_FPS=60
Environment=STEAM_REMOTE_SCALE=2
Environment=STEAM_REMOTE_SESSION_MODE=gamescope
Environment=STEAM_REMOTE_STEAM_CHANNEL=stable
Environment=STEAM_REMOTE_STEAMRT3=0
Environment=STEAM_STARTUP_ARGS=-bigpicture
Environment=AMD_VULKAN_ICD=RADV
Exec=run

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
